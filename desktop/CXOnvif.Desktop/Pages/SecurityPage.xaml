<Page
    x:Class="CXOnvif.Desktop.Pages.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="28,22,28,28" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" MaxWidth="900" HorizontalAlignment="Stretch">

            <StackPanel Spacing="4">
                <TextBlock Text="安全" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="管理员登录与密码管理。令牌仅保存在内存中，不会写入磁盘。" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <InfoBar
                x:Name="MustChangeBar"
                IsOpen="False"
                IsClosable="False"
                Severity="Warning"
                Title="需要修改初始密码"
                Message="当前账号仍在使用初始密码，请立即修改后再继续使用。" />

            <InfoBar
                x:Name="MessageBar"
                IsOpen="False"
                IsClosable="True"
                Severity="Informational" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="管理员登录" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock
                        Text="默认账号 admin / cx123456，首次登录后需要强制改密。密码只用于换取令牌，不在本地保存。"
                        Style="{StaticResource BodyStyle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="UsernameBox"
                            Grid.Column="0"
                            Header="用户名"
                            Text="admin" />
                        <PasswordBox
                            x:Name="PasswordBox"
                            Grid.Column="1"
                            Header="密码"
                            PasswordRevealMode="Peek"
                            KeyDown="PasswordBox_KeyDown" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button
                            x:Name="LoginButton"
                            Content="登录"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Login_Click" />
                        <Button
                            x:Name="LogoutButton"
                            Content="注销"
                            IsEnabled="False"
                            Click="Logout_Click" />
                        <TextBlock
                            x:Name="SessionText"
                            Text="当前未登录"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionStyle}" />
                    </StackPanel>

                    <TextBlock x:Name="AuthStateText" Style="{StaticResource CaptionStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="修改密码" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock
                        Text="修改成功后，服务端会吊销现有令牌，需要重新登录。建议使用 12 位以上的强密码。"
                        Style="{StaticResource BodyStyle}" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox
                            x:Name="CurrentPasswordBox"
                            Grid.Column="0"
                            Header="当前密码"
                            PasswordRevealMode="Peek" />
                        <PasswordBox
                            x:Name="NewPasswordBox"
                            Grid.Column="1"
                            Header="新密码"
                            PasswordRevealMode="Peek" />
                        <PasswordBox
                            x:Name="ConfirmPasswordBox"
                            Grid.Column="2"
                            Header="确认新密码"
                            PasswordRevealMode="Peek" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Button
                            x:Name="ChangeButton"
                            Content="修改密码"
                            Click="ChangePassword_Click" />
                        <TextBlock
                            Text="新密码至少 8 位，且不能与当前密码相同。"
                            VerticalAlignment="Center"
                            Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="安全说明" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock
                        Text="• 桌面端不会把密码或令牌写入 settings.json。&#x0a;• 令牌保存在进程内存中，关闭窗口即失效。&#x0a;• 若忘记密码，可在仓库根目录执行 python -m cxonvif password 重置。"
                        Style="{StaticResource BodyStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
