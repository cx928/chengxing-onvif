<Window
    x:Class="CXOnvif.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{StaticResource PageBackgroundBrush}">
        <NavigationView
            x:Name="Nav"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="224"
            CompactPaneLength="48"
            IsPaneOpen="True"
            SelectionChanged="Nav_SelectionChanged"
            Background="Transparent">

            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="4,10,0,16">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource BrandSoftBrush}">
                        <FontIcon
                            Glyph="&#xE714;"
                            FontFamily="Segoe Fluent Icons"
                            FontSize="15"
                            Foreground="{StaticResource BrandBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            Text="程星 ONVIF"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock
                            Text="桌面控制台"
                            FontSize="11"
                            Foreground="{StaticResource TextTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" Tag="overview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="安全" Tag="security">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="启动项" Tag="autostart">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7E8;" FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe Fluent Icons" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <TextBlock
                    Text="v1.0.0 · MIT"
                    Margin="12,10,0,12"
                    FontSize="11"
                    Foreground="{StaticResource TextTertiaryBrush}" />
            </NavigationView.PaneFooter>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
