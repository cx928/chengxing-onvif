<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CXOnvif.Desktop</RootNamespace>
    <AssemblyName>CXOnvif.Desktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>程星 ONVIF 控制台</Product>
    <Company>程星 ONVIF</Company>
    <Copyright>© 2026 程星 ONVIF</Copyright>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250909003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
    <!--
      命令行（无 Visual Studio）构建 WinUI 3 时，PRI 资源生成需要 MSIX 构建任务；
      Microsoft.WindowsAppSDK 自带的 MrtCore.PriGen.targets 依赖 VS 的 AppxPackage 任务。
      引入该包后使用其自带的 WinAppSdkExpandPriContent 任务，dotnet build 才能成功。
    -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.260930100" />
  </ItemGroup>

</Project>
